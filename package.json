{
  "name": "oie-web-client",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "OIE Web Client monorepo: the web administrator app + the @oie/web-* framework packages plugin authors build against.",
  "license": "MPL-2.0",
  "workspaces": [
    "packages/*",
    "web-administrator"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p type-tests/tsconfig.json && tsc -p web-administrator/tsconfig.json && tsc -p web-administrator/tsconfig.server.json --noEmit && tsc -p web-administrator/tsconfig.plugins.json && tsc -p web-administrator/tsconfig.views.json && tsc -p e2e/tsconfig.json",
    "pree2e": "npm run build -w web-administrator",
    "e2e": "playwright test",
    "e2e:live": "E2E_LIVE=1 playwright test --project=live",
    "test": "npm test -w web-administrator",
    "build:war": "npm run build:war -w web-administrator",
    "wiki:screenshots": "playwright test --config tools/wiki-playwright.config.ts",
    "vendor:zip": "esbuild node_modules/@zip.js/zip.js/lib/zip-core.js --bundle --format=esm --minify --legal-comments=none --outfile=web-administrator/client/vendor/zipjs.min.js",
    "gen:userapi": "node web-administrator/tools/gen-userapi.mjs"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@playwright/test": "^1.62.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "dompurify": "3.4.12"
  }
}
