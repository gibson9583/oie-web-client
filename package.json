{
  "name": "oie-web-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OIE Web Client monorepo: the web administrator app + the @oie/web-* framework packages plugin authors build against.",
  "license": "MPL-2.0",
  "workspaces": [
    "packages/*",
    "web-administrator"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p type-tests/tsconfig.json",
    "pree2e": "npm run build -w web-administrator",
    "e2e": "playwright test",
    "e2e:live": "E2E_LIVE=1 playwright test --project=live",
    "test": "npm test -w web-administrator",
    "vendor:zip": "esbuild node_modules/@zip.js/zip.js/lib/zip-core.js --bundle --format=esm --minify --legal-comments=none --outfile=web-administrator/client/vendor/zipjs.min.js",
    "gen:userapi": "node web-administrator/tools/gen-userapi.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.6",
    "js-yaml": "^4.3.0",
    "dompurify": "3.4.12"
  }
}
