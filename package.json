{
  "name": "oie-web-client",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "OIE Web Client monorepo: the web administrator app + the @oie/web-* framework packages plugin authors build against.",
  "license": "MPL-2.0",
  "workspaces": [
    "packages/*",
    "web-administrator"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p type-tests/tsconfig.json && tsc -p web-administrator/tsconfig.json && tsc -p web-administrator/tsconfig.server.json --noEmit && tsc -p web-administrator/tsconfig.plugins.json && tsc -p web-administrator/tsconfig.views.json && tsc -p e2e/tsconfig.json",
    "pree2e": "npm run build -w web-administrator",
    "e2e": "playwright test",
    "e2e:live": "E2E_LIVE=1 playwright test --project=live",
    "pretest": "node web-administrator/tools/build-vendor.mjs",
    "test": "npm test -w web-administrator && node --test tools/*.test.mjs",
    "build:war": "npm run build:war -w web-administrator",
    "wiki:screenshots": "playwright test --config tools/wiki-playwright.config.ts",
    "vendor:zip": "node web-administrator/tools/build-zip.mjs",
    "gen:userapi": "node web-administrator/tools/gen-userapi.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "dompurify": "3.4.17"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
