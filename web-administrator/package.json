{
  "name": "oie-web-administrator",
  "version": "1.0.0",
  "description": "Web-based administrator for Open Integration Engine (Mirth Connect fork). Standalone NodeJS app that mirrors the Swing Administrator and is pluggable by extension developers.",
  "license": "MPL-2.0",
  "main": "server/index.js",
  "bin": {
    "oie-webadmin": "server/index.js"
  },
  "scripts": {
    "prestart": "node tools/build-vendor.mjs",
    "start": "node server/index.js",
    "predev": "node tools/build-vendor.mjs",
    "dev": "WEBADMIN_DEV=1 node --watch-path=./server server/index.js",
    "build": "node tools/build-vendor.mjs && vite build && node tools/build-plugins.mjs && node tools/build-connectors.mjs",
    "test": "for f in client/core/*.test.js server/*.test.js; do node \"$f\" || exit 1; done"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@zip.js/zip.js": "^2.8.34",
    "express": "^5.2.1",
    "js-beautify": "^2.0.3",
    "monaco-editor": "^0.56.0",
    "qrcode-generator": "2.0.4",
    "dicom-parser": "^1.8.21"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  }
}
